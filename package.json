{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "pnpm build:portfolio && pnpm --dir hexhaven build",
    "preview": "vite preview",
    "test": "pnpm test:portfolio && pnpm --dir hexhaven test",
    "build:portfolio": "vite build && vite build --ssr src/entry-server.jsx --outDir build-ssr && node scripts/prerender.mjs",
    "test:portfolio": "node --test tests/*.test.mjs",
    "typecheck": "pnpm --dir hexhaven typecheck",
    "lint": "pnpm --dir hexhaven lint",
    "sim": "pnpm --dir hexhaven sim",
    "dev:hexhaven": "pnpm --dir hexhaven dev",
    "e2e": "pnpm --dir hexhaven e2e"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@9.9.0"
}
